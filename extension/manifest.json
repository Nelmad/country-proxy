{
  "manifest_version": 3,
  "name": "Country Proxy",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "description": "Выберите страну: автоматический поиск, HTTPS-проверка и замена бесплатных прокси.",
  "key": "",
  "permissions": [
    "proxy",
    "storage",
    "nativeMessaging",
    "alarms",
    "privacy"
  ],
  "host_permissions": [
    "https://www.cloudflare.com/*",
    "https://www.google.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Country Proxy"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "incognito": "not_allowed"
}
