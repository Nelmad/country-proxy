{
  "schema_version": 1,
  "checks": [
    {
      "name": "native-unit",
      "command": [
        "python3",
        "-B",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-p",
        "test_*.py"
      ],
      "mode": "read-only",
      "requires_network": false,
      "timeout_seconds": 90
    },
    {
      "name": "controller-unit",
      "command": [
        "node",
        "--test",
        "tests/controller.test.js",
        "tests/favorites.test.js",
        "tests/favorites-background.test.js",
        "tests/stop.test.js",
        "tests/traffic-gate.test.js",
        "tests/traffic-gate-controller.test.js",
        "tests/saved-groups.test.js",
        "tests/group-backup.test.js",
        "tests/https-probe-observer.test.mjs",
        "tests/netlog-phase.test.mjs",
        "tests/netlog-projection.test.mjs",
        "tests/failover-evidence.test.mjs",
        "tests/refill-evidence.test.mjs"
      ],
      "mode": "read-only",
      "requires_network": false,
      "timeout_seconds": 90
    },
    {
      "name": "structure",
      "command": [
        "python3",
        "-B",
        "scripts/validate.py"
      ],
      "mode": "read-only",
      "requires_network": false,
      "timeout_seconds": 90
    }
  ]
}
